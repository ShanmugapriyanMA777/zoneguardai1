# ZoneGuard AI - Environment Configuration

# Core Application
PROJECT_NAME="ZoneGuard AI"
SECRET_KEY="zoneguard-ai-sih-secret-key-super-secure-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment Mode
DEMO_MODE=true
REAL_DATA_MODE=false

# Database Configuration (SQLite default; can use PostGIS)
DATABASE_URL="sqlite:///./zoneguard.db"
# DATABASE_URL="postgresql://zoneguard_admin:zoneguard_pw@localhost:5432/zoneguard_db"

# Copernicus Data Space Ecosystem (CDSE) Sentinel-1 API (Optional / Production)
CDSE_API_URL="https://catalogue.dataspace.copernicus.eu/resto/api"
CDSE_CLIENT_ID=""
CDSE_CLIENT_SECRET=""

# Server & Port (Cloud containers)
PORT=8000

# Frontend API Target (Only needed if Frontend is deployed separately, e.g., on Vercel)
# Leave empty for local development or Docker / fullstack deployment
VITE_API_URL=""
# Example for Vercel pointing to Render:
# VITE_API_URL="https://zoneguard-backend.onrender.com"

# Default District Coordinates (Tamil Nadu Nilgiris & Western Ghats)
DEFAULT_DISTRICT="Nilgiris-Western Ghats Hazard Corridor (Tamil Nadu)"
DISTRICT_CENTER_LAT=11.3530
DISTRICT_CENTER_LNG=76.7950
